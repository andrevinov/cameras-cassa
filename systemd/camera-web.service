[Unit]
Description=Local camera web interface
After=network-online.target go2rtc.service
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=/opt/cameras-cassa/web
ExecStart=/usr/bin/python3 -m http.server 8090 --bind 127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
