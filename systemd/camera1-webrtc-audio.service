[Unit]
Description=Camera 1 WebRTC audio transcoder
After=mediamtx.service
Requires=mediamtx.service

[Service]
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
ExecStart=/usr/bin/ffmpeg -hide_banner -loglevel warning -rtsp_transport tcp -i rtsp://127.0.0.1:8554/camera1 -c:v copy -c:a libopus -b:a 64k -ar 48000 -ac 1 -f rtsp -rtsp_transport tcp rtsp://127.0.0.1:8554/camera1-web
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
