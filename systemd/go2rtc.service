[Unit]
Description=go2rtc camera talkback bridge
After=network-online.target mediamtx.service camera1-webrtc-audio.service
Wants=network-online.target
Requires=mediamtx.service

[Service]
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
ExecStart=/usr/local/bin/go2rtc -config /etc/go2rtc.yaml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
