# Generated runtime file is /etc/mediamtx.env and MUST NOT be committed.

MTX_MOQ=false
MTX_RTMP=false
MTX_SRT=false

MTX_PATHS_CAMERA1_SOURCE=rtsp://admin:CHANGE_ME@192.168.0.9:554/cam/realmonitor?channel=1&subtype=0
MTX_PATHS_CAMERA1_RTSPTRANSPORT=tcp

MTX_PATHS_CAMERA1_RECORD=true
MTX_PATHS_CAMERA1_RECORDPATH=/var/lib/cameras-cassa/buffer/%path/%Y-%m-%d/%H-%M-%S-%f
MTX_PATHS_CAMERA1_RECORDFORMAT=fmp4
MTX_PATHS_CAMERA1_RECORDPARTDURATION=1s
MTX_PATHS_CAMERA1_RECORDSEGMENTDURATION=10m
MTX_PATHS_CAMERA1_RECORDDELETEAFTER=0s
MTX_PATHS_CAMERA1_RUNONRECORDSEGMENTCOMPLETE=/usr/local/bin/camera-upload-segment
