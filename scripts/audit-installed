#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SERVICE_USER="${SUDO_USER:-${USER:-andre}}"
SERVICE_GROUP="$(id -gn "$SERVICE_USER" 2>/dev/null || printf '%s' "$SERVICE_USER")"

if [ -r /etc/cameras-cassa/config.env ]; then
  # shellcheck disable=SC1091
  source /etc/cameras-cassa/config.env
fi

echo "== scripts =="
for name in camera-upload-segment camera-retry-upload camera-buffer-guard camera-drive-retention camera-user; do
  echo
  echo "===== $name ====="
  if [ -f "/usr/local/bin/$name" ]; then
    diff -u "$ROOT/scripts/$name" "/usr/local/bin/$name" || true
  else
    echo "MISSING: /usr/local/bin/$name"
  fi
done

echo
echo "== web backend =="
for file in app.py manage_users.py requirements.txt templates/login.html templates/index.html; do
  echo
  echo "===== $file ====="
  if [ -f "/opt/cameras-cassa/web/$file" ]; then
    diff -u "$ROOT/web/$file" "/opt/cameras-cassa/web/$file" || true
  else
    echo "MISSING: /opt/cameras-cassa/web/$file"
  fi
done

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

echo
echo "== systemd =="
for unit in "$ROOT"/systemd/*; do
  name="$(basename "$unit")"
  sed     -e "s/__SERVICE_USER__/$SERVICE_USER/g"     -e "s/__SERVICE_GROUP__/$SERVICE_GROUP/g"     -e "s/__SERVER_LAN_IP__/${SERVER_LAN_IP:-192.168.0.10}/g"     "$unit" > "$tmp/$name"

  echo
  echo "===== $name ====="
  if [ -f "/etc/systemd/system/$name" ]; then
    diff -u "$tmp/$name" "/etc/systemd/system/$name" || true
  else
    echo "MISSING: /etc/systemd/system/$name"
  fi
done

redact_urls() {
  sed -E     -e 's#(rtsp://[^:]+:)[^@[:space:]'"'"']+@#\1***@#g'     -e 's#(dvrip://[^:]+:)[^@[:space:]'"'"']+@#\1***@#g'
}

echo
echo "== MediaMTX runtime config (redacted) =="
if [ -r /etc/mediamtx.env ]; then
  redact_urls < /etc/mediamtx.env
else
  echo "MISSING: /etc/mediamtx.env"
fi

echo
echo "== go2rtc runtime config (redacted) =="
if [ -r /etc/go2rtc.yaml ]; then
  redact_urls < /etc/go2rtc.yaml
else
  echo "MISSING: /etc/go2rtc.yaml"
fi

echo
echo "== authentication =="
if [ -f /etc/cameras-cassa/session-secret ]; then
  stat -c 'session-secret: mode=%a owner=%U group=%G' /etc/cameras-cassa/session-secret
else
  echo "MISSING: /etc/cameras-cassa/session-secret"
fi

if [ -f /var/lib/cameras-cassa/users.sqlite3 ]; then
  echo "users database exists"
else
  echo "MISSING: /var/lib/cameras-cassa/users.sqlite3"
fi
