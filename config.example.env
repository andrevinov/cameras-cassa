# Non-secret installation defaults.
# install.sh prompts for these values and writes the effective runtime config
# to /etc/cameras-cassa/config.env.

SERVER_LAN_IP=192.168.0.10
LAN_CIDR=192.168.0.0/24

CAMERA1_NAME=camera1
CAMERA1_IP=192.168.0.9
CAMERA1_USER=admin
CAMERA1_RTSP_PORT=554

RCLONE_REMOTE=gdrive
RCLONE_BASE_PATH=Cameras-Casa/Gravacoes

RECORD_SEGMENT_DURATION=10m
RETRY_MIN_AGE_MINUTES=2
BUFFER_GUARD_MIN_AGE_MINUTES=15
MIN_FREE_GB=20
RETENTION_DAYS=7
